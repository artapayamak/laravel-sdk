{
  "name": "artapayamak/laravel-sdk",
  "description": "ArtaPayamak Laravel SDK for IPPanel API",
  "version": "1.0.5",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "ArtaPayamak",
      "email": "info@artapayamak.com"
    }
  ],
  "require": {
    "php": "^7.4|^8.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Ippanel\\": "src/IPPanel/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Ippanel\\IppanelServiceProvider"
      ],
      "aliases": {
        "IPPanel": "Ippanel\\Facades\\IPPanel"
      }
    }
  },
  "keywords": [
    "artapayamak",
    "laravel",
    "sms",
    "ippanel",
    "php-sdk",
    "notification"
  ],
  "homepage": "https://github.com/artapayamak/laravel-sdk",
  "minimum-stability": "stable"
}
